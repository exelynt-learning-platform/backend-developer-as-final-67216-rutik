# Copy this file to `.env` (or export these as real environment variables)
# before running the application. See README.md "Environment Variables"
# for full details on each one.
#These credentials only for development and review purpose directly are given here like db username and password.
#In production, should use a secure way to manage secrets and sensitive information, such as environment variables, secret management services, or encrypted configuration files.

# --- Server ---
SERVER_PORT=8080

# --- Database (PostgreSQL by default) ---
DB_URL=jdbc:postgresql://localhost:5432/booking_system
DB_USERNAME=booking_user
DB_PASSWORD=booking_pass
DB_DRIVER=org.postgresql.Driver
JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# --- To use MySQL instead ---
# Also pass SPRING_PROFILES_ACTIVE=mysql when starting the app, then:
# DB_URL=jdbc:mysql://localhost:3306/booking_system?useSSL=false&serverTimezone=UTC
# DB_USERNAME=booking_user
# DB_PASSWORD=booking_pass
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# JPA_DIALECT=org.hibernate.dialect.MySQLDialect

# --- Schema management ---
# update: auto-create/alter tables on startup (fine for local dev/evaluation)
# validate: only verify schema matches entities (use with a real migration tool)
DDL_AUTO=update
SHOW_SQL=false
SQL_INIT_MODE=always

# --- JWT ---
# MUST be overridden with a long random string (32+ bytes) in any real deployment.
# Generate one with: openssl rand -base64 48
JWT_SECRET=this-is-a-development-only-secret-key-please-override-in-prod-min-32-bytes
JWT_EXPIRATION_MS=86400000

# --- Logging ---
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=WARN
