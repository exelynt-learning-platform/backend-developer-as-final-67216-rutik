{
  "info": {
    "name": "Resource Booking System",
    "description": "RESTful Resource Booking System API - JWT auth, RBAC, resources, reservations. Import this alongside the accompanying environment file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login as User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('userToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user1\",\n  \"password\": \"user123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Register New User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        }
      ]
    },
    {
      "name": "Resources",
      "item": [
        {
          "name": "List Resources (paginated)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/resources?page=0&size=10&sort=id,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "resources"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sort", "value": "id,asc" }
              ]
            }
          }
        },
        {
          "name": "Get Resource By Id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/resources/1", "host": ["{{baseUrl}}"], "path": ["api", "resources", "1"] }
          }
        },
        {
          "name": "Create Resource (Admin only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('createdResourceId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Conference Room C\",\n  \"description\": \"Small huddle room\",\n  \"type\": \"ROOM\",\n  \"location\": \"Building 2, Floor 1\",\n  \"available\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/resources", "host": ["{{baseUrl}}"], "path": ["api", "resources"] }
          }
        },
        {
          "name": "Update Resource (Admin only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Conference Room C (Renovated)\",\n  \"description\": \"Small huddle room, now with a TV\",\n  \"type\": \"ROOM\",\n  \"location\": \"Building 2, Floor 1\",\n  \"available\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/resources/{{createdResourceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "resources", "{{createdResourceId}}"]
            }
          }
        },
        {
          "name": "Delete Resource (Admin only)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/resources/{{createdResourceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "resources", "{{createdResourceId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Reservations",
      "item": [
        {
          "name": "Create Reservation (as User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('createdReservationId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceId\": 1,\n  \"startTime\": \"2027-01-15T09:00:00\",\n  \"endTime\": \"2027-01-15T11:00:00\",\n  \"price\": 45.00,\n  \"notes\": \"Team planning session\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/reservations", "host": ["{{baseUrl}}"], "path": ["api", "reservations"] }
          }
        },
        {
          "name": "List My Reservations (as User)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/reservations?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "List All Reservations (as Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/reservations", "host": ["{{baseUrl}}"], "path": ["api", "reservations"] }
          }
        },
        {
          "name": "Filter Reservations by Status + Price Range",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/reservations?status=PENDING&minPrice=10&maxPrice=100&sort=price,desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations"],
              "query": [
                { "key": "status", "value": "PENDING" },
                { "key": "minPrice", "value": "10" },
                { "key": "maxPrice", "value": "100" },
                { "key": "sort", "value": "price,desc" }
              ]
            }
          }
        },
        {
          "name": "Get Reservation By Id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/reservations/{{createdReservationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations", "{{createdReservationId}}"]
            }
          }
        },
        {
          "name": "Cancel My Reservation (as User)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CANCELLED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reservations/{{createdReservationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations", "{{createdReservationId}}"]
            }
          }
        },
        {
          "name": "Confirm Reservation + Adjust Price (as Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\",\n  \"price\": 50.00,\n  \"notes\": \"Approved by admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reservations/{{createdReservationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations", "{{createdReservationId}}"]
            }
          }
        },
        {
          "name": "Delete Reservation",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/reservations/{{createdReservationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations", "{{createdReservationId}}"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminToken", "value": "" },
    { "key": "userToken", "value": "" },
    { "key": "createdResourceId", "value": "" },
    { "key": "createdReservationId", "value": "" }
  ]
}
